{
  "expo": {
    "name": "TailorApp",
    "slug": "tailor-management",
    "version": "1.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "tailorapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tailorapp.mobile"
    },
    "android": {
      "package": "com.tailorapp.mobile",
      "versionCode": 4
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ]
  }
}
