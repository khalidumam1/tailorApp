{
  "expo": {
    "name": "TailorApp",
    "slug": "tailor-management",
    "version": "1.2.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "tailorapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tailorapp.mobile"
    },
    "android": {
      "package": "com.tailorapp.mobile",
      "versionCode": 7
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ]
    ]
  }
}
