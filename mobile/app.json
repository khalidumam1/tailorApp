{
  "expo": {
    "name": "Bizora",
    "slug": "tailor-management",
    "version": "1.2.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "tailorapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tailorapp.mobile"
    },
    "android": {
      "package": "com.tailorapp.mobile",
      "versionCode": 7
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            },
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ]
  }
}
