{
  "name": "@tailor/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build:shared && expo start",
    "android": "npm run build:shared && expo run:android",
    "ios": "npm run build:shared && expo run:ios",
    "typecheck": "npm run build:shared && tsc --noEmit",
    "build:shared": "node scripts/build-shared.mjs",
    "test": "tsx --test src/data/__tests__/*.test.ts",
    "test:live": "tsx --test src/data/__tests__/live-api.test.ts"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "57.0.3",
    "expo-file-system": "^57.0.7",
    "expo-network": "57.0.2",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "~57.0.0",
    "expo-status-bar": "57.0.1",
    "pdf-lib": "^1.17.1",
    "@tailor/shared": "file:./shared",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "7.25.9",
    "@types/react": "19.2.7",
    "typescript": "6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "@babel/runtime": "7.29.7",
    "@expo/metro-file-map": "57.0.4",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
