{
  "name": "@tailor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:shared && node scripts/dev-server.mjs",
    "build": "npm run build:shared && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm run build:shared && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "test": "tsx --test test/*.test.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:acceptance:templates": "tsx --test test/business-templates.acceptance.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:platform-admin": "tsx scripts/bootstrap-platform-admin.ts",
    "build:shared": "npm run build --prefix shared"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tailor/shared": "file:./shared",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pdfkit": "0.17.2",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.14.0",
    "@types/pdfkit": "0.17.3",
    "prisma": "6.19.3",
    "tsx": "4.19.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
