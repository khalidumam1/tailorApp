  journalEntry       JournalEntry        @relation(fields: [journalEntryId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@unique([businessId, idempotencyKey])
  @@unique([journalEntryId, businessId])
  @@index([businessId, financialAccountId, occurredAt])
}

model FinancialOpeningBalance {
  id                 String            @id @default(uuid()) @db.Uuid
  businessId         String            @db.Uuid
  accountId          String            @db.Uuid
  amount             Decimal           @db.Decimal(14, 2)
  asOf               DateTime          @db.Timestamptz(3)
  idempotencyKey     String            @db.VarChar(120)
  actorId            String            @db.Uuid
  journalEntryId     String            @db.Uuid
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  account            FinancialAccount  @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Restrict)
  journalEntry       JournalEntry      @relation(fields: [journalEntryId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, accountId])
  @@unique([businessId, idempotencyKey])
  @@unique([journalEntryId, businessId])
}

model BankReconciliation {
  id              String               @id @default(uuid()) @db.Uuid
  businessId      String               @db.Uuid
  accountId       String               @db.Uuid
  statementStart  DateTime             @db.Timestamptz(3)
  statementEnd    DateTime             @db.Timestamptz(3)
  openingBalance  Decimal              @db.Decimal(14, 2)
  closingBalance  Decimal              @db.Decimal(14, 2)
  status          ReconciliationStatus @default(OPEN)
  idempotencyKey  String?              @db.VarChar(120)
  actorId         String               @db.Uuid
  closedAt        DateTime?            @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  account         FinancialAccount     @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Restrict)
  matches         BankReconciliationMatch[]

  @@unique([id, businessId])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, accountId, statementEnd])
}

model BankReconciliationMatch {
  id                String              @id @default(uuid()) @db.Uuid
  businessId        String              @db.Uuid
  reconciliationId  String              @db.Uuid
  journalLineId     String              @db.Uuid
  matchedById       String              @db.Uuid
  matchedAt         DateTime            @default(now()) @db.Timestamptz(3)
  reconciliation   BankReconciliation @relation(fields: [reconciliationId, businessId], references: [id, businessId], onDelete: Restrict)
  journalLine       JournalLine        @relation(fields: [journalLineId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, reconciliationId, journalLineId])
  @@unique([businessId, journalLineId])
  @@index([businessId, reconciliationId])
}
