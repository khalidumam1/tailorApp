NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://tailor:local-development-only@localhost:5432/tailor?schema=public
POSTGRES_USER=tailor
POSTGRES_PASSWORD=local-development-only
ACCESS_TOKEN_SECRET=generate-a-unique-secret-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
API_BASE_URL=http://localhost:5000
# WhatsApp credentials are consumed by the backend only; never copy these to mobile or web config.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
WHATSAPP_ORDER_TEMPLATE=tailor_order_created
WHATSAPP_PAYMENT_TEMPLATE=tailor_payment_received
WHATSAPP_READY_TEMPLATE=tailor_order_ready
WHATSAPP_TEMPLATE_LANGUAGE=en
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
# Production bootstrap only; the API does not read these variables.
BOOTSTRAP_SUPER_ADMIN=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
