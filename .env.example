NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://tailor:local-development-only@localhost:5432/tailor?schema=public
POSTGRES_USER=tailor
POSTGRES_PASSWORD=local-development-only
ACCESS_TOKEN_SECRET=generate-a-unique-secret-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
API_BASE_URL=http://localhost:5000
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
# Production bootstrap only; the API does not read these variables.
BOOTSTRAP_SUPER_ADMIN=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
