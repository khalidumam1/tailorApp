{
  "name": "@tailor/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-shared.mjs && vite",
    "build": "node scripts/build-shared.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/build-shared.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@tailor/shared": "file:./shared",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
